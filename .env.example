# --- Server / database ---
DATABASE_URL=sqlite:////data/caltrack.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Food data sources ---
OFF_API_BASE_URL=https://world.openfoodfacts.org
# Free key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=

# --- LLM (optional; app is fully usable with LLM_PROVIDER=none) ---
# One of: none | anthropic | openai | ollama
LLM_PROVIDER=none

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=

# Point at a machine on your LAN running Ollama (e.g. a Mac mini), not the Pi itself.
OLLAMA_HOST=http://ollama-host.local:11434
OLLAMA_TEXT_MODEL=
OLLAMA_VISION_MODEL=

# --- Web client ---
# Comma-separated origins allowed to call the API (e.g. http://caltrack.local:5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Base URL the /web app should call for the API, injected at container start
API_BASE_URL=http://localhost:8000
